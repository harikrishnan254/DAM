<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AEM DAM API - Regression" parallel="classes" thread-count="3">

    <listeners>
        <listener class-name="com.qa.aem.listeners.ExtentReportListener"/>
    </listeners>

    <test name="Regression">
        <classes>
            <class name="com.qa.aem.tests.HealthCheckTest"/>
            <class name="com.qa.aem.tests.AssetCrudTest"/>
            <class name="com.qa.aem.tests.MetadataSearchTest"/>
        </classes>
    </test>
</suite>
